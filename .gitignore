# Yii Console Commands  
/yii  
/yii_test  
/yii_test.bat  

# IDE Project Files  
.idea/                  # PhpStorm  
nbproject/              # NetBeans  
.buildpath              # Zend Studio  
.project                # Zend Studio  
.settings/              # Zend Studio  

# OS-Specific Files  
Thumbs.db               # Windows Thumbnail Cache  
.DS_Store               # macOS Finder Cache  

# Composer  
/vendor/                # Composer dependencies  
composer.phar           # Composer itself  
/composer.lock  

# PHPUnit  
/phpunit.phar           # PHPUnit itself  
/phpunit.xml            # Local PHPUnit config  

# Vagrant  
/.vagrant  

# Logs & Runtime Data  
/backend/runtime/  
/frontend/runtime/  
/console/runtime/  

# Node.js & Frontend  
/node_modules/  

# Uploaded Files (Keep safe outside Git)  
/uploads/  

# Web Generated Files (can be rebuilt)  
/frontend/web/assets/  
/backend/web/assets/  

# Config Files (If using environment-specific settings)  
/.env  

